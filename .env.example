# ── 模型接入（必填 2 项）────────────────────────────────────────
# 推荐：阿里云百炼，一个 Key 同时提供 对话 / 视觉 / 嵌入
# 控制台 https://bailian.console.aliyun.com/
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-请替换
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-请替换

# ── 四个模型角色（各有分工，不要用一个模型全包）──────────────────
# 这些模型名来自实际账号的 /v1/models 探测，务必先跑 npm run probe 确认
MODEL_REASON=qwen3.8-max
MODEL_EXTRACT=qwen-flash
MODEL_VISION=qwen3-vl-plus
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024

# ── 存储路径 ──────────────────────────────────────────────────
DB_PATH=./data/learner.db
TEXTBOOK_DIR=./data/textbook
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# ── 教师反馈（方案 C+：极轻汇聚端，只收脱敏摘要）────────────────
# 留空则完全本地运行，不向任何服务器发送数据
AGGREGATOR_URL=
SYNC_PERIOD_DAYS=7

# ── 服务端口 ──────────────────────────────────────────────────
PORT=8787
