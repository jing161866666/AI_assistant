# ── 模型接入：两家供应商（分工见 模型应用.md）────────────────────
# qwen（阿里云百炼）：看图转录 + 向量化。控制台 https://bailian.console.aliyun.com/
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-请替换
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-请替换

# DeepSeek：解题 / 判对错 / 结构化抽取（实测比 qwen3.8-max 快 5-30 倍）
# 注意：FAST_BASE_URL 与 FAST_API_KEY 缺失时会回退到上面的 qwen 地址+Key，
# 但模型名仍是 deepseek-*，对端会 400。所以这三项要和两个 MODEL_* 一起配。
FAST_BASE_URL=https://api.deepseek.com/v1
FAST_API_KEY=sk-请替换

# ── 五个模型角色（各有分工，不要用一个模型全包）──────────────────
# 模型名务必先跑 npm run probe / npm run test-llm 实测（别抄文档）
# reason 兼判对错：实测 deepseek-chat 会把数量级错 1000 倍判成正确，禁止换
MODEL_REASON=deepseek-reasoner
MODEL_EXTRACT=deepseek-chat
MODEL_FAST=deepseek-chat
MODEL_VISION=qwen3-vl-plus
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024

# ── 存储路径 ──────────────────────────────────────────────────
DB_PATH=./data/learner.db
TEXTBOOK_DIR=./data/textbook
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# ── 教师反馈（方案 C+：极轻汇聚端，只收脱敏摘要）────────────────
# 留空则完全本地运行，不向任何服务器发送数据
AGGREGATOR_URL=
SYNC_PERIOD_DAYS=7

# ── 服务端口 ──────────────────────────────────────────────────
PORT=8787
# 监听地址。默认 127.0.0.1 = 只有本机能开；0.0.0.0 = 同局域网可访问（无鉴权，注意隐私）
HOST=127.0.0.1
